---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import {
  getDraftPath,
  getDraftSlug,
  getDraftSourcePath,
  getDraftTitle,
} from "@/utils/drafts";
import { SITE } from "@/config";

type DraftEntry = CollectionEntry<"drafts">;

type DraftTreeNode = {
  name: string;
  title?: string;
  href?: string;
  sourcePath?: string;
  children: Map<string, DraftTreeNode>;
};

const escapeHtml = (value: string) =>
  value.replace(
    /[&<>"']/g,
    char =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[char] ?? char
  );

const createNode = (name: string): DraftTreeNode => ({
  name,
  children: new Map(),
});

const getSourceSegments = (draft: DraftEntry) =>
  draft.id.replace(/\.mdx?$/i, "").split(/[\\/]/).filter(Boolean);

const insertDraft = (root: DraftTreeNode, draft: DraftEntry) => {
  const slugSegments = getDraftSlug(draft).split("/").filter(Boolean);
  const sourceSegments = getSourceSegments(draft);
  let currentNode = root;

  slugSegments.forEach((slugSegment, index) => {
    const sourceSegment = sourceSegments[index] ?? slugSegment;

    if (!currentNode.children.has(slugSegment)) {
      currentNode.children.set(slugSegment, createNode(sourceSegment));
    }

    currentNode = currentNode.children.get(slugSegment)!;

    if (index === slugSegments.length - 1) {
      currentNode.title = getDraftTitle(draft);
      currentNode.href = getDraftPath(draft);
      currentNode.sourcePath = getDraftSourcePath(draft);
    }
  });
};

const sortNodes = (nodes: Iterable<DraftTreeNode>) =>
  [...nodes].sort((a, b) => {
    const aIsDir = a.children.size > 0 && !a.href;
    const bIsDir = b.children.size > 0 && !b.href;

    if (aIsDir !== bIsDir) return aIsDir ? -1 : 1;
    return a.name.localeCompare(b.name);
  });

const renderTree = (nodes: Iterable<DraftTreeNode>): string => {
  const sortedNodes = sortNodes(nodes);

  if (sortedNodes.length === 0) return "";

  return `<ul class="mt-2 ml-4 list-none border-l border-dashed border-accent/30 pl-4">
${sortedNodes
  .map((node): string => {
    const label = node.title ?? node.name;
    const sourcePath = node.sourcePath
      ? `<div class="text-xs text-accent/70">${escapeHtml(node.sourcePath)}</div>`
      : "";
    const content = node.href
      ? `<a class="font-medium text-accent underline-offset-4 hover:underline" href="${escapeHtml(
          node.href
        )}">${escapeHtml(label)}</a>${sourcePath}`
      : `<span class="font-semibold">${escapeHtml(node.name)}</span>`;

    return `<li class="my-2">${content}${renderTree(node.children.values())}</li>`;
  })
  .join("\n")}
</ul>`;
};

const drafts = await getCollection("drafts");
const sortedDrafts = drafts.sort((a, b) =>
  getDraftSlug(a).localeCompare(getDraftSlug(b))
);
const root = createNode("drafts");

sortedDrafts.forEach(draft => insertDraft(root, draft));

const title = `Drafts | ${SITE.title}`;
const description = "Hidden draft browser for local notes and unpublished posts.";
const treeHtml = renderTree(root.children.values());
---

<Layout title={title} description={description} robots="noindex, nofollow">
  <Header />
  <main
    id="main-content"
    class="app-layout py-8"
    data-pagefind-ignore
  >
    <h1 class="text-2xl font-bold text-accent sm:text-3xl">Drafts</h1>
    <p class="mt-3 text-sm text-accent/80">
      Hidden draft index. These pages are excluded from public navigation,
      sitemap output, robots crawling, and Pagefind indexing.
    </p>
    <p class="mt-2 text-sm text-accent/70">
      Total drafts: {sortedDrafts.length}
    </p>
    <nav class="app-prose mt-8 max-w-app" set:html={treeHtml} />
  </main>
  <Footer />
</Layout>
